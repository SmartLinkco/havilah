# Public canonical origin for metadata, sitemap and Open Graph.
# Example: https://havilahagro.com
# On Vercel, an empty value falls back to https://$VERCEL_URL.
NEXT_PUBLIC_SITE_URL=

# Resend API key. Required before inquiry and quote emails can send.
RESEND_API_KEY=

# Inbox that receives inquiries. Use the address Kwame chooses.
INQUIRY_TO_EMAIL=

# Verified sender. Example: Havilah Agro <inquiries@yourdomain.com>
# The buyer's address is set as Reply-To, so replies go to the buyer.
INQUIRY_FROM_EMAIL=

# Optional Cloudflare Turnstile. Set both to show the widget and verify it.
# If TURNSTILE_SECRET_KEY is unset, the server skips the check.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional Google Analytics 4 measurement ID, for example G-XXXXXXXX.
# The script is omitted when this is empty or not in that shape.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
